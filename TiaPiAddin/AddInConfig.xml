<?xml version="1.0" encoding="utf-8"?>
<PackageConfiguration xmlns="http://www.siemens.com/automation/Openness/AddIn/Publisher/V20">
  <Author>PiAgent</Author>
  <Description>Sends contextual commands from TIA Portal directly to the Pi Coding Agent</Description>
  <AddInVersion>1.0.0.0</AddInVersion>
  <Product>
    <Name>Pi Agent Integration</Name>
    <Id>PiAgent.AddIn.Integration</Id>
    <Version>1.0.0.0</Version>
  </Product>
  <FeatureAssembly>
    <AssemblyInfo>
      <Assembly>TiaPiAddin.dll</Assembly>
    </AssemblyInfo>
  </FeatureAssembly>
  <RequiredPermissions>
    <TIAPermissions>
      <TIA.ReadWrite />
    </TIAPermissions>
    <SecurityPermissions>
      <System.Net.SocketPermission />
      <System.Net.WebPermission />
      <System.Security.Permissions.UIPermission />
    </SecurityPermissions>
  </RequiredPermissions>
</PackageConfiguration>
