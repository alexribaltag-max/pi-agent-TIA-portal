<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TiaPiAddin</AssemblyName>
    <RootNamespace>TiaPiAddin</RootNamespace>
    <!-- Add-ins usually run alongside TIA Portal -->
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adjust the path to Siemens.Engineering.AddIn.dll and Siemens.Engineering.dll according to the local TIA installation -->
    <Reference Include="Siemens.Engineering.AddIn">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20.AddIn\Siemens.Engineering.AddIn.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- In TIA V16+, Siemens.Engineering.AddIn often duplicates or forwards interfaces.
         Try removing the direct Siemens.Engineering.dll reference if there are CS0433 type conflicts. -->
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AddInConfig.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
