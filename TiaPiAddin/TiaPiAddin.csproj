<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TiaPiAddin</AssemblyName>
    <RootNamespace>TiaPiAddin</RootNamespace>
    <!-- Add-ins usually run alongside TIA Portal -->
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TiaPortalPublicApiPath Condition=" '$(TiaPortalPublicApiPath)' == '' ">C:\Program Files\Siemens\Automation\Portal V21\PublicAPI\V21\net48</TiaPortalPublicApiPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- TIA Portal V21 uses modular Openness/Add-In assemblies under PublicAPI\V21\net48. -->
    <Reference Include="Siemens.Engineering.Base">
      <HintPath>$(TiaPortalPublicApiPath)\Siemens.Engineering.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.Step7">
      <HintPath>$(TiaPortalPublicApiPath)\Siemens.Engineering.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.AddIn.Base">
      <HintPath>$(TiaPortalPublicApiPath)\Siemens.Engineering.AddIn.Base.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Siemens.Engineering.AddIn.Step7">
      <HintPath>$(TiaPortalPublicApiPath)\Siemens.Engineering.AddIn.Step7.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <None Include="AddInConfig.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
